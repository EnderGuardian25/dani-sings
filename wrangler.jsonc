{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danella-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Incremental cache for ISR (24h follower-count revalidation).
  // Create the namespace with:  npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // then replace the placeholder id below with the one it prints.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // Required by the revalidation queue — must match "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "danella-portfolio"
    }
  ]
}
