# ─── Instagram Graph API (live follower count) ──────────────────────────────
# Copy this file to ".env.local" and fill in the two values below.
# See INSTAGRAM_SETUP.md for step-by-step instructions on getting them.
#
# Without these, the site falls back to the unofficial scraper, then to a
# static number — so the site never breaks if they're missing.

# Numeric ID of the Instagram Business/Creator account (NOT the @username).
IG_USER_ID=

# Long-lived (or system-user) Meta access token with instagram_basic scope.
IG_GRAPH_TOKEN=
